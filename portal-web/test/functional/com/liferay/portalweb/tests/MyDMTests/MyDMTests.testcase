@component-name = "portal-document-management"
definition {

	property custom.properties = "default.layout.template.id=1_column${line.separator}dl.actions.visible=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Document Management";

	setUp {
		task ("Login") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Create Site and Page") {
			JSONGroup.addGroup(groupName = "Guest");

			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}

		task ("Create Document and File Upload") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentDescription = "Document Description",
				dmDocumentFile = "Document_1.jpg",
				dmDocumentTitle = "DM Document JPG");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			DMDocument.tearDownCP();

			User.logoutPG();
		}
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		task ("Edit Title,File and Description of the Document") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.editCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentDescriptionEdit = "DM Document Description Edit",
				dmDocumentFileEdit = "Document_1.jpg",
				dmDocumentFileNameEdit = "Document_3.jpg",
				dmDocumentTitle = "DM Document JPG",
				dmDocumentTitleEdit = "DM Document Test");
		}

		task ("Check if the content was edited") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document Test");

			DMDocument.viewCP(
				dmDocumentDescription = "DM Document Description Edit",
				dmDocumentTitle = "DM Document Test",
				mDocumentFile = "Document_3.jpg");
		}
	}

}