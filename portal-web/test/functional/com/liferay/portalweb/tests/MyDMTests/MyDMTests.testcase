@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		task ("Login into the portal") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Create a Page and add the Documents and Media widget") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}

		task ("Go to Portlet and upload a DM") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document Title",
				groupName = "Guest",
				mimeType = "image/png",
				sourceFileName = "analytics-cloud-hero-image.png");
		}

		task ("Go to Documents and Media Page") {
			Navigator.gotoPage(pageName = "Documents and Media Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			task ("Delete pages and Documents that have been created") {
				JSONLayout.deletePublicLayout(
					groupName = "Guest",
					layoutName = "Documents and Media Page");

				DMDocument.tearDownCP();

				PagesAdmin.tearDownCP();

				User.logoutPG();
			}
		}
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		task ("Edit Document and Media") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");

			DMDocument.editCP(
				dmDocumentFileEdit = "Document_4.jpg",
				dmDocumentFileNameEdit = "Document_4.jpg",
				dmDocumentTitle = "DM Document Title",
				dmDocumentTitleEdit = "DM Document Title 2");
		}

		task ("See if the DM was edited") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document Title 2");

			DMDocument.viewCP(
				dmDocumentFileName = "Document_4.jpg",
				dmDocumentTitle = "DM Document Title 2");
		}
	}

}