@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task ("Creates a new page and adds a DM widget in it via API") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");

			Navigator.gotoPage(pageName = "Documents and Media Page");
		}

		task ("Creates new DM via API") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "For Document Viewers Eyes Only",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_4.jpg");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			DMDocument.tearDownCP();

			DMFolder.tearDownCP();

			User.logoutPG();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		task ("Adds a new document via user UI") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentFile = "Document_1.txt",
				dmDocumentTitle = "DM Document Title");
		}

		task ("Validate that the new DM was really created") {
			DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document Title");

			DMDocument.viewCP(dmDocumentTitle = "DM Document Title");
		}
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		task ("Adds a new document via user UI") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentFile = "Document_1.jpg",
				dmDocumentTitle = "DM Document Title");
		}

		task ("Delete the API's DM, validate that it was really deleted and validate that the UI DM still exists") {
			DMDocument.deleteCP(dmDocumentTitle = "For Document Viewers Eyes Only");

			DMDocument.cannotViewCP(dmDocumentTitle = "For Document Viewers Eyes Only");

			DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document Title");

			DMDocument.viewCP(dmDocumentTitle = "DM Document Title");
		}
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		task ("Adds a new document via user UI") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.addCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentFile = "Document_1.jpg",
				dmDocumentTitle = "DM Document Title");
		}

		task ("Edit the DM") {
			DMDocument.editCP(
				dmDocumentFileEdit = "これは写真です.jpg",
				dmDocumentFileNameEdit = "これは写真です.jpg",
				dmDocumentTitle = "DM Document Title",
				dmDocumentTitleEdit = "DM Document Title 2");
		}

		task ("Validate that the DM title was really edited") {
			Navigator.openSitePage(
				pageName = "Documents and Media Page",
				siteName = "Guest");

			DMDocument.viewPG(
				dmDocumentDescription = "DM Document Description",
				dmDocumentFileName = "これは写真です.jpg",
				dmDocumentTitle = "DM Document Title 2");
		}
	}

}