@component-name = "portal-document-management"
definition {

	property custom.properties = "default.layout.template.id=1_column${line.separator}dl.actions.visible=true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Document Management";

	var pageName = "Documents and Media Page";
	var portletName = "Documents and Media";

	setUp {
		task ("Create portal instance and login") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();

			Navigator.openURL();
		}

		task ("Create page of DM1") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");
		}

		task ("Add a widget for DM type1") {
			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}

		task ("Go to the DM page") {
			Navigator.gotoPage(pageName = "Documents and Media Page");
		}

		task ("Add a image in the DM page1") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "imagem 1",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "high_resolution_photo.jpg");
		}

		task ("Add a image in the DM page2") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "imagem 2",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_1.jpg");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");

			User.logoutPG();
		}
	}

	@description = "Editing a DM"
	@priority = "5"
	test CanDownloadDM {
		task ("Go to the page DM") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.enableActionsMenuOnPortlet();
		}

		task ("Download the image 2") {
			DMDocument.downloadCP(
				dmDocumentSize = "13 KB",
				dmDocumentTitle = "imagem 2");
		}

		task ("Image 1 file show was not downloaded") {
			DMDocument.assertFileNameFromTempFolder(fileName = "Document_1.jpg");
		}

		task ("Showing that image 2 was no downloaded") {
			DMDocument.assertNoFileNameFromTempFolder(translationFileName = "high_resolution_photo.jpg");
		}
	}

}