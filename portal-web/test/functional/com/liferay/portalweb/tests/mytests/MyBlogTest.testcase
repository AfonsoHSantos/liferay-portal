@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs");

		Navigator.gotoPage(pageName = "Blogs Page");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");
		}
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		task ("Add an entry on the page and show success message") {
			Blogs.addEntry(
				entryContent = "Blog Entry Content",
				entrySubtitle = "Test Blog",
				entryTitle = "Test Blog");

			Alert.viewSuccessMessage();
		}

		task ("Go to the page and view entries") {
			Navigator.openURL();

			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Entry Content",
				entryTitle = "Test Blog");
		}
	}

	@description = "Can Edit a Blog"
	@priority = "5"
	test CanEditBlog {
		task ("Edit entries on the blog") {
			JSONBlog.addEntry(
				entryContent = "Blog Entry Content",
				entryTitle = "Test Title");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("Edit entries on the blog") {
			Blogs.editEntryPG(
				entryContent = "Blog Entry Content",
				entryContentEdit = "Blog Edit",
				entryTitle = "Test Title",
				entryTitleEdit = "Edited Title");
		}

		task ("Go to page and view entries") {
			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsNavigator.gotoEntryPG(
				entryContent = "Blog Edit",
				entryTitle = "Edited Title");

			BlogsEntry.viewEntryPG(
				entryContent = "Blog Edit",
				entryTitle = "Edited Title");
		}
	}

}