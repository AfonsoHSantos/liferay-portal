@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		task ("Go to portal and make login for start of the test") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Make a blogs page and add a widget layout") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");
		}

		task ("Go to blogs page") {
			Navigator.gotoPage(pageName = "Blogs Page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");
		}
	}

	@description = "Can Search Blogs"
	@priority = "5"
	test CanSearchBlogs {
		task ("Add 2 blogs entry") {
			JSONBlog.addEntry(
				entryContent = "Blog Entry Content",
				entryTitle = "Blogs Entry Title1");

			JSONBlog.addEntry(
				entryContent = "Blog Entry Content",
				entryTitle = "Blogs Entry Title2");
		}

		task ("Search for the entry 1") {
			Navigator.gotoPage(pageName = "Blogs Page");

			SearchPortlets.searchEmbedded(searchTerm = "&quot;Blogs Entry Title1&quot;");

			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Blogs Entry Title1",
				searchAssetType = "Blogs Entry",
				searchTerm = "&quot;Blogs Entry Title1&quot;");
		}

		task ("Assert the entry 2 its not found") {
			BlogsEntry.viewNoCP(entryTitle = "&quot;Blogs Entry Title2&quot;");
		}

		task ("search for no exists entrys and show the menssage that no results, and make the validation on the text of no match results") {
			Navigator.gotoPage(pageName = "Blogs Page");

			SearchPortlets.searchEmbedded(searchTerm = "&quot;Blogs Entry Title3&quot;");

			AssertTextEquals.assertPartialText(
				locator1 = "Message#EMPTY_INFO",
				value1 = "No results were found that matched the keywords");
		}
	}

}