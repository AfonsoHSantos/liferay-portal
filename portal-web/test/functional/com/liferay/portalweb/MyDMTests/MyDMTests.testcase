@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		task ("Opening the portal and doing the Login") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Creating a Page with a Documents and Media widget") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media page",
				widgetName = "Documents and Media");
		}

		task ("Entering in the Documents and Media page") {
			Navigator.gotoPage(pageName = "Documents and Media page");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media page");

			DMDocument.tearDownCP();

			User.logoutPG();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		task ("Create a new Documents and Media") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");
		}

		task ("Documents and Media should display on the page") {
			DMDocument.addCP(
				dmDocumentDescription = "Document Description",
				dmDocumentFile = "Document_2.jpg",
				dmDocumentTitle = "DM Document JPG Node2");
		}

		task ("Verify that the new Document and Media has been created") {
			Navigator.gotoPage(pageName = "Documents and Media page");

			DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document JPG Node2");

			DMDocument.viewCP(dmDocumentTitle = "DM Document JPG Node2");
		}
	}

	@description = "Can Edit a Documents and Media"
    @priority = "5"
    test CanEditDM {
		task ("Create a new Documents and Media") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");
		}
		task ("Documents and Media should display on the page") {	
			DMDocument.addCP(
				dmDocumentDescription = "Document Description1",
				dmDocumentFile = "Commerce_Blue.jpg",
				dmDocumentTitle = "foto1");
		}
		task ("Edit the Documents and Media")	{			
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "foto1");
			
			DMDocument.editCmd(
			dmDocumentDescriptionEdit = "Document Description2",
			dmDocumentFileEdit = "Document_2.jpg",
			dmDocumentTitleEdit = "foto2");

			Button.clickPublish(); }

		task ("Assert the Documents and Media should be edited") {

			Navigator.gotoPage(pageName = "Documents and Media page");

			DMNavigator.gotoDocumentCP(dmDocumentTitle = "foto2");

			DMDocument.viewCP(dmDocumentTitle = "foto2");
		}
		
    	

	}

}